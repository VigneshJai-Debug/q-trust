# Q-Trust Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Chain Configuration ──────────────────────────────────────────────────────
# Use "true" for Base mainnet, "false" for Base Sepolia testnet
QTRUST_USE_MAINNET=false

# RPC endpoint (public RPCs are rate-limited; use Alchemy/Infura for production)
QTRUST_BASE_SEPOLIA_RPC=https://sepolia.base.org
# QTRUST_BASE_MAINNET_RPC=https://mainnet.base.org

# ── Relayer Configuration ────────────────────────────────────────────────────
# Private key for the relayer account (signs and submits transactions)
# WARNING: Never commit this to version control!
QTRUST_RELAYER_PRIVATE_KEY=0x_your_relayer_private_key_here
# Fallback to deployer key if relayer key not set
QTRUST_DEPLOYER_PRIVATE_KEY=0x_your_deployer_private_key_here

# ── Contract Addresses (Base Sepolia) ────────────────────────────────────────
# Deploy contracts first, then paste addresses here
QTRUST_ASSET_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
QTRUST_VENDOR_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
QTRUST_MIGRATION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
QTRUST_AUDIT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
QTRUST_REVOCATION_ANCHOR_ADDRESS=0x0000000000000000000000000000000000000000
QTRUST_POLICY_COMMITMENT_ADDRESS=0x0000000000000000000000000000000000000000
QTRUST_SCHEMA_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
QTRUST_TRUST_ANCHOR_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# ── API Security ─────────────────────────────────────────────────────────────
# Comma-separated admin API keys for write endpoints
# If empty and NODE_ENV=production, ALL write routes are disabled
QTRUST_API_KEYS=your-api-key-1,your-api-key-2

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (required in production, no wildcards)
QTRUST_CORS_ORIGINS=https://app.qtrust.dev,https://qtrust.dev

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
QTRUST_PG_URL=postgres://qtrust:qtrust@localhost:5432/qtrust

# ── Redis ────────────────────────────────────────────────────────────────────
QTRUST_REDIS_URL=redis://localhost:6379

# ── Planner Microservice ─────────────────────────────────────────────────────
QTRUST_PLANNER_URL=http://localhost:8000

# ── Webhooks ─────────────────────────────────────────────────────────────────
# Comma-separated webhook delivery URLs
QTRUST_WEBHOOKS=

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_QTRUST_API_URL=http://localhost:3001
NEXT_PUBLIC_QTRUST_CHAIN_ID=84532
NEXT_PUBLIC_QTRUST_ASSET_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_QTRUST_VENDOR_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# ── Docker Compose Database Credentials ──────────────────────────────────────
POSTGRES_USER=qtrust
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=qtrust
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION
