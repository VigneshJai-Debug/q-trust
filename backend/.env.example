# Q-Trust backend environment.
# Copy to .env and fill in your values. For local testing, run anvil locally
# (see sdk/tests/run_e2e.sh) and deploy the contracts, then set the addresses.

PORT=3001
HOST=0.0.0.0

# RPC for Base Sepolia (or a local anvil instance)
QTRUST_BASE_SEPOLIA_RPC=http://127.0.0.1:8545

# Relayer signing key (for attestation service)
# Replace with your own private key — NEVER commit real keys to git.
QTRUST_RELAYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# QTRUST_DEPLOYER_PRIVATE_KEY=

# Deployed contract addresses (set after Phase 1 deployment)
QTRUST_ASSET_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
QTRUST_VENDOR_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
QTRUST_MIGRATION_REGISTRY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
QTRUST_AUDIT_REGISTRY_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# Trust infrastructure contract addresses
QTRUST_REVOCATION_ANCHOR_ADDRESS=
QTRUST_POLICY_COMMITMENT_ADDRESS=
QTRUST_SCHEMA_REGISTRY_ADDRESS=
QTRUST_TRUST_ANCHOR_REGISTRY_ADDRESS=

# Redis for the webhook service (docker-compose provides one)
QTRUST_REDIS_URL=redis://localhost:6379

# Optional: Basescan API key for contract verification
QTRUST_BASESCAN_API_KEY=