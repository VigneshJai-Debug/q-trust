# Q-Trust backend environment.
# Copy to .env and fill in your values. For local testing, run anvil locally
# (see sdk/tests/run_e2e.sh) and deploy the contracts, then set the addresses.
#
# Tiers:
#   [REQUIRED]        — fails to start in production without these.
#   [OPTIONAL / GPU]  — only when QTRUST_GPU_ENABLED=true.
#   [PRODUCTION-ONLY] — dummy OK in dev, must be replaced in prod.

# ── Core (all tiers) ─────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
QTRUST_PUBLIC_URL=http://localhost:3001

# ── [REQUIRED] RPC + contracts ───────────────────────────────────────────────
# REQUIRED: production refuses plain http:// (L-8).
QTRUST_BASE_SEPOLIA_RPC=http://127.0.0.1:8545
# QTRUST_BASE_MAINNET_RPC=https://mainnet.base.org

# Ordered RPC failover pool (comma-separated). Falls back to QTRUST_BASE_SEPOLIA_RPC.
# Failed endpoints are skipped for 60s before being retried.
# QTRUST_RPC_URLS=https://sepolia.base.org,https://base-sepolia.publicnode.com

# REQUIRED in production — no fallback, no dev key.
# Replace with your own private key — NEVER commit real keys to git.
QTRUST_RELAYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# QTRUST_DEPLOYER_PRIVATE_KEY=

# Deployed contract addresses (set after Phase 1 deployment)
QTRUST_ASSET_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
QTRUST_VENDOR_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
QTRUST_MIGRATION_REGISTRY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
QTRUST_AUDIT_REGISTRY_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
QTRUST_REVOCATION_ANCHOR_ADDRESS=
QTRUST_POLICY_COMMITMENT_ADDRESS=
QTRUST_SCHEMA_REGISTRY_ADDRESS=
QTRUST_TRUST_ANCHOR_REGISTRY_ADDRESS=

# ── [REQUIRED] Infra ─────────────────────────────────────────────────────────
# REQUIRED: webhook queue + rate limiter; evidence chain.
QTRUST_REDIS_URL=redis://localhost:6379
QTRUST_PG_URL=postgres://qtrust:qtrust@localhost:5432/qtrust  # optional fallback → RPC

# ── [PRODUCTION-ONLY] Secrets & gating ──────────────────────────────────────
# REQUIRED in production: comma-separated admin API keys (write routes disabled if empty).
# QTRUST_API_KEYS=your-api-key-1,your-api-key-2
# REQUIRED in production: allowed CORS origins (no wildcards).
# QTRUST_CORS_ORIGINS=https://app.qtrust.dev
# REQUIRED in production: H-5 webhook ENC key (fail-closed); dev stores plaintext.
# QTRUST_WEBHOOK_ENC_KEY= # openssl rand -hex 32
# REQUIRED in production (HIGH-1): shared planner key forwarded as X-Api-Key.
# QTRUST_PLANNER_API_KEY= # openssl rand -hex 32
# Optional: Basescan API key for contract verification
QTRUST_BASESCAN_API_KEY=

# ── [OPTIONAL / GPU] ─────────────────────────────────────────────────────────
# Only when QTRUST_GPU_ENABLED=true. Safe to leave unset otherwise.
# See docs/GPU_FEATURES.md, Makefile.gpu.
QTRUST_GPU_ENABLED=false
# Override path to backend/scripts/gpu_bridge.py if deployed elsewhere.
QTRUST_GPU_BRIDGE=
# Pre-trained model checkpoints (409 when untrained).
QTRUST_SIDE_CHANNEL_MODEL=
QTRUST_ANOMALY_MODEL=
