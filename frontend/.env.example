# Public API URL — the Q-Trust Fastify backend.
# In production this is your hosted backend (e.g. https://api.qtrust.dev).
# In dev, Next.js rewrites /api/* to this URL.
NEXT_PUBLIC_QTRUST_API_URL=http://localhost:3001

# Public IPFS gateway for fetching CBOM metadata.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# WalletConnect project ID — required by RainbowKit/wagmi for wallet connections.
# Create one free at https://cloud.walletconnect.com. The code falls back to the
# placeholder string "demo" when unset, which lets dev builds compile but real
# wallet connections require a valid project ID.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=demo

# Chain selection: leave unset/empty for Base Sepolia (default); set to "true"
# to target Base mainnet. Must match where QTRUST_VENDOR_REGISTRY_ADDRESS etc.
# are deployed.
QTRUST_USE_MAINNET=
